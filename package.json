{
  "name": "cylons-app",
  "version": "2.0.0",
  "description": "CYLONS - Aplicación de asistencia de navegación accesible para personas con discapacidad visual. Grupo JOVIAL. Entrega final: Front-End Angular + Back-End Node.js/Express.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "api": "node backend/server.js",
    "api:dev": "node --watch backend/server.js",
    "api:reset": "node backend/reiniciar-datos.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.0",
    "@angular/cli": "^20.1.0",
    "@angular/compiler-cli": "^20.1.0",
    "typescript": "~5.8.3"
  }
}
